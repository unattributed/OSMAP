  ],
  "test_designs": {
    "UX01": {
      "positive": "Follow each navigation link or native disclosure with keyboard and pointer; selected page and signed-in identity agree with the response.",
      "negative": "Invalid session redirects; long/escaped identity cannot inject markup; no external request or script; absent backend has no success claim."
    },
    "UX02": {
      "positive": "Select light/dark/system, reload, navigate and log out; sign into a second account and recover its own preference; inspect every HTML route and native control.",
      "negative": "Malformed/duplicate theme input defaults safely; forged/CSRF write refused; parallel appearance and security-preference writes preserve both; rollback reads old settings."
    },
    "UX03": {
      "positive": "Use the named list/search/sort/selection/flag control with empty, single and multiple results; verify stable bounded ordering and visible state after reload.",
      "negative": "Unknown folder, stale UID, invalid filter/sort, oversized query/selection and cross-account request refuse or use documented safe default without command execution."
    },
    "UX04": {
      "positive": "Perform the named action on a controlled message; verify resulting mailbox/flags and preserved query/selection, including restore and partial bulk results.",
      "negative": "Reject missing CSRF, wrong owner, duplicate/stale tuple and excessive bulk selection; no permanent delete or automatic retry after unknown outcome."
    },
    "UX05": {
      "positive": "Open the named reader/body/source/attachment control for synthetic plain and HTML MIME; verify escaped or sanitized content, exact authorised source and forced-download bytes.",
      "negative": "Cross-account/stale UID/part denied; hostile names/content cannot create active markup; remote resources remain blocked; size/depth limits refuse safely."
    },
    "UX06": {
      "positive": "Exercise the named compose identity/recipient/draft/header control; save/resume preserves allowed values and source context; Reply All excludes self and deduplicates recipients.",
      "negative": "Forged sender, header injection, malformed addresses, stale draft revision, cross-account draft and interrupted save do not send or overwrite unrelated state."
    },
    "UX07": {
      "positive": "Apply the named formatting/upload/remove/preview control to synthetic text and local files; preview and independently parsed emitted MIME agree; draft resume preserves selected attachments.",
      "negative": "Reject hostile markup/URL, oversized/unsafe filename/content and path traversal; no remote fetch; interrupted uploads clean only owned scratch; failed send preserves values."
    },
    "UX08": {
      "positive": "Exercise the named preflight/sign/encrypt/self/schedule/send option with usable disposable keys; inspect delivered bytes and Sent reconciliation, including local sink receipt.",
      "negative": "Missing/revoked/expired/ambiguous key, locked agent, stale policy, Bcc leak and unknown submission block success; no downgrade or automatic duplicate send."
    },
    "UX09": {
      "positive": "Inspect the named account/key/status control using unconfigured, configured and unavailable account states; full fingerprints and capability come from actual authorised records.",
      "negative": "No copied example fingerprint/date, guessed capability, script clipboard success, global search on account settings or cross-account public binding."
    },
    "UX10": {
      "positive": "Save each signing/encryption/self policy with fresh step-up, reload and enforce it against actual delivered bytes; stale policies rechecked at dispatch.",
      "negative": "Reject CSRF, stale/replayed step-up and unusable keys; required protection cannot be bypassed by forged form fields or delayed send."
    },
    "UX11": {
      "positive": "Change a disposable own-account password through the authoritative helper; verify new authentication, old-password refusal, timestamp and scoped session revocation.",
      "negative": "Wrong/stale password/TOTP, replay, races and partial backend failure cannot report complete success; unknown backend status remains unknown."
    },
    "UX12": {
      "positive": "Add/verify/replace/remove a disposable recovery contact through a local sink; exercise governed recovery transitions with explicitly labelled test custody.",
      "negative": "Expired/replayed tokens, resend limits, same-mailbox-only proof, absent independent identity attestation and interrupted factor mutation cannot bypass MFA or auto-restore factors."
    },
    "UX13": {
      "positive": "Inspect the principles strip against actual CSP, assets, renderer and crypto execution location.",
      "negative": "No zero-knowledge/browser-only plaintext, guaranteed safety or enabled-crypto claim without evidence; hostile mail cannot inject a status badge."
    },
    "UX14": {
      "positive": "Upload/list/download/bin/restore/delete synthetic private documents; exact bytes, quota totals and retention state reconcile across restart.",
      "negative": "Other account/forged ID/CSRF, unsafe name, MIME ambiguity, overquota and interrupted write denied safely; no inline preview or host-path disclosure."
    },
    "UX15": {
      "positive": "Independently verify/decrypt disposable PGP/MIME through the native helper and distinguish result, identity binding, key validity and sanitized rendering.",
      "negative": "Tamper/wrong key/unknown signer/revoked key/unsupported format/timeout fail closed; verified/decrypted never bypasses sanitizer or becomes a safety claim."
    },
    "UX16": {
      "positive": "Induce the named empty/error/unavailable state through real route and controlled backend outcomes; visible guidance offers only valid, safe recovery actions.",
      "negative": "Error cannot leak secrets, private paths or wrong-account state; retries are read-only and cannot duplicate submission or privileged mutation."
    },
    "UX17": {
      "positive": "Complete the named interaction/accessibility journey in normal and key-enabled/disabled accounts; record approved full-navigation and host-plaintext deviations explicitly.",
      "negative": "No script/CSP expansion, missing auth/CSRF, unbounded helper work or unproven human acceptance; failed controls remain open."
    }
  },

OSMAP_BASE_URL=https://mail.blackbagsecurity.com
OSMAP_HOST=mail.blackbagsecurity.com
OSMAP_SSH_HOST=mail.blackbagsecurity.com
OSMAP_TEST_EMAIL=
OSMAP_TEST_PASSWORD=
OSMAP_TOTP_SECRET=
OSMAP_SECONDARY_EMAIL=
OSMAP_OUTPUT_DIR=
OSMAP_WSTG_REMOTE_REPO=/home/foo/OSMAP
OSMAP_WSTG_EXPECTED_REF=
OSMAP_WSTG_SOURCE_NAME=OWASP Web Security Testing Guide
OSMAP_WSTG_SOURCE_URL=https://owasp.org/www-project-web-security-testing-guide/v42/
OSMAP_WSTG_SOURCE_VERSION=v4.2
OSMAP_WSTG_SOURCE_COMMIT=
OSMAP_WSTG_MATRIX_FILE=wstg-scenario-matrix.v42.json
OSMAP_RATE_LIMIT_DELAY_SECONDS=1
OSMAP_ALLOW_AUTHENTICATED_TESTS=false
OSMAP_PROMPT_AUTH=false

# Latest-track source pin example for V3 due diligence.
# OSMAP_WSTG_SOURCE_URL=https://github.com/OWASP/wstg/tree/8eb4e023d0116a4f5196f56ae9e69db1798888a0
# OSMAP_WSTG_SOURCE_VERSION=latest
# OSMAP_WSTG_SOURCE_COMMIT=8eb4e023d0116a4f5196f56ae9e69db1798888a0
# OSMAP_WSTG_MATRIX_FILE=wstg-scenario-matrix.latest.json

# Optional safe tuning.
OSMAP_THROTTLE_PROBE_ATTEMPTS=3
# Connection establishment stays short for intentionally closed ports, while
# authentication responses may include Dovecot's bounded penalty delay.
OSMAP_CONNECT_TIMEOUT_SECONDS=5
OSMAP_REQUEST_TIMEOUT_SECONDS=20
OSMAP_ALLOW_HOST_ASSISTED_TESTS=false

#!/bin/ksh
# Combined foreground Rust service. Installation never enables or starts it.
daemon="/usr/local/libexec/osmap/account-passwd"
daemon_user="root"
daemon_flags=""
rc_bg=YES
rc_reload=NO
. /etc/rc.d/rc.subr
# Main only: the private fixed metadata worker must never match this service.
pexp="^${daemon}\$"

rc_configtest() {
	[ "${daemon_user}" = "root" ] && [ -z "${daemon_flags}" ]
}

rc_start() {
	rc_configtest || return 1
	rc_exec "${daemon}"
}

rc_check() {
	pgrep -T "${daemon_rtable}" -U 0 -u 0 -q -xf "${pexp}"
}

_rc_sendsig() {
	# rc.subr also uses this seam for delayed TERM and timeout KILL.
	case "${1:-TERM}" in
	TERM|KILL)
		pkill "-${1:-TERM}" -T "${daemon_rtable}" -U 0 -u 0 -xf "${pexp}"
		;;
	*) return 1 ;;
	esac
}

rc_stop() {
	_rc_sendsig TERM
}
rc_cmd "$1"

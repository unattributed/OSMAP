#!/bin/ksh
# Combined foreground Rust service. Installation never enables or starts it.
daemon="/usr/local/libexec/osmap/account-passwd"
daemon_user="root"
daemon_flags=""
rc_bg=YES
rc_reload=NO
. /etc/rc.d/rc.subr
# Main only: the private fixed metadata worker must never match this service.
pexp="^${daemon}\$"
helper_log="/var/log/osmap-account-password.log"

rc_configtest() {
	[ "${daemon_user}" = "root" ] && [ -z "${daemon_flags}" ]
}

rc_prepare_log() {
	[ "$(/usr/bin/id -u)" = 0 ] || return 1
	[ -d /var/log ] && [ ! -L /var/log ] || return 1
	set -- $(/usr/bin/stat -f '%u %p' /var/log) || return 1
	[ "$#" -eq 2 ] && [ "$1" = 0 ] || return 1
	case "$2" in ''|*[!0-7]*) return 1 ;; esac
	(( (8#$2 & 8#22) == 0 )) || return 1
	if [ ! -e "${helper_log}" ] && [ ! -L "${helper_log}" ]; then
		(umask 077; set -C; : > "${helper_log}") || return 1
	fi
	# Full file mode encodes regular type and exactly0600; no symlink or
	# multiply linked diagnostic sink can be adopted by this root service.
	[ -f "${helper_log}" ] && [ ! -L "${helper_log}" ] &&
		[ "$(/usr/bin/stat -f '%u:%p:%l' "${helper_log}")" = '0:100600:1' ]
}

rc_start() {
	rc_configtest || return 1
	rc_prepare_log || {
		print -u2 -- 'osmap_account_password: PRIVATE_LOG_CUSTODY_REFUSED'
		return 1
	}
	# The root monitor shell opens stdout/stderr before Rust confinement.
	# Retain that shell: replacing it with exec breaks rc.subr startup ALRM.
	rc_exec "${daemon} >> ${helper_log} 2>&1"
}

rc_check() {
	pgrep -T "${daemon_rtable}" -U 0 -u 0 -q -xf "${pexp}"
}

_rc_sendsig() {
	# rc.subr also uses this seam for delayed TERM and timeout KILL.
	case "${1:-TERM}" in
	TERM|KILL)
		pkill "-${1:-TERM}" -T "${daemon_rtable}" -U 0 -u 0 -xf "${pexp}"
		;;
	*) return 1 ;;
	esac
}

rc_stop() {
	_rc_sendsig TERM
}
rc_cmd "$1"

#!/bin/ksh
# One account's pre-provisioned volume. Never formats, sets quotas or migrates.
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin
export PATH
daemon=/usr/local/libexec/osmap/storage-quota
rc_reload=NO
rc_usercheck=NO
. /etc/rc.d/rc.subr
# This one-shot owns mounts, not a daemon process. Never signal a quota reader.
daemon_timeout=240
pexp='osmap_duncan_storage_has_no_daemon_process'
_rc_sendsig() { return 1; }

storage_config=/etc/osmap/duncan-storage.conf
storage_mount=/var/osmap-storage/accounts/duncan
storage_home=$storage_mount/Maildir
storage_uid=2000
storage_limit=209715200
storage_guard=/root/osmap-duncan-check
storage_log=

bounded() {
    typeset remaining=$((${storage_deadline:?}-$(date +%s)))
    [[ $remaining -gt 0 ]] || return 1
    [[ $remaining -le 60 ]] || remaining=60
    if [[ -n $storage_log ]]; then
        print -r -- "COMMAND=$1" >> "$storage_log" || return 1
        /usr/bin/timeout -k 2 "$remaining" "$@" 2>> "$storage_log" | tee -a "$storage_log"
    else
        /usr/bin/timeout -k 2 "$remaining" "$@"
    fi
}

must() {
    "$@" || {
        typeset status=$?
        [[ -z $storage_log ]] || print -r -- "REFUSED_STEP=$1 STATUS=$status" >> "$storage_log"
        exit 1
    }
}

root_parent() {
    typeset path=$1 mode
    [[ $path = /* && $(realpath "$path") = "$path" ]] || return 1
    while :; do
        [[ -d $path && ! -L $path && $(stat -f '%u' "$path") = 0 ]] || return 1
        mode=$(stat -f '%Lp' "$path") || return 1
        [[ -n $mode && $mode != *[!0-7]* ]] || return 1
        (( (8#$mode & 022) == 0 )) || return 1
        [[ $path != / ]] || break
        path=${path%/*}
        [[ -n $path ]] || path=/
    done
}

profile() {
    typeset key value path
    [[ $(id -u) = 0 && -f $storage_config && ! -L $storage_config ]] || return 1
    [[ $(stat -f '%u:%g:%Lp:%l' "$storage_config") = 0:0:600:1 ]] || return 1
    root_parent "${storage_config%/*}" && root_parent "${storage_mount%/*}" || return 1
    storage_image= storage_vnd= storage_index= storage_control= storage_worker_sha=
    while IFS='=' read -r key value || [[ -n $key$value ]]; do
        [[ -n $value ]] || return 1
        case "$key" in
        image) [[ -z $storage_image ]] || return 1; storage_image=$value;;
        vnd) [[ -z $storage_vnd ]] || return 1; storage_vnd=$value;;
        index) [[ -z $storage_index ]] || return 1; storage_index=$value;;
        control) [[ -z $storage_control ]] || return 1; storage_control=$value;;
        worker_sha) [[ -z $storage_worker_sha ]] || return 1; storage_worker_sha=$value;;
        *) return 1;;
        esac
    done < "$storage_config"
    case "$storage_vnd" in vnd[0-3]) ;; *) return 1;; esac
    [[ ${#storage_worker_sha} = 64 && $storage_worker_sha != *[!0-9a-f]* ]] || return 1
    for path in "$storage_image" "$storage_index" "$storage_control"; do
        [[ $path = /* && $path != *[!a-zA-Z0-9_./-]* && $path != *'/../'* && $path != */.. ]] || return 1
        [[ $(realpath "$path") = "$path" && ! -L $path ]] || return 1
    done
    [[ -f $storage_image && $(stat -f '%u:%g:%Lp:%l' "$storage_image") = 0:0:600:1 ]] || return 1
    root_parent "${storage_image%/*}" || return 1
    root_parent "${daemon%/*}" || return 1
    [[ -f $daemon && ! -L $daemon && $(stat -f '%u:%l' "$daemon") = 0:1 ]] || return 1
    case $(stat -f '%Lp' "$daemon") in 555|755) ;; *) return 1;; esac
    [[ $(sha256 -q "$daemon") = "$storage_worker_sha" && $(id -u vmail) = "$storage_uid" ]] || return 1
    storage_inode=$(stat -f '%i' "$storage_image") || return 1
    storage_device=/dev/${storage_vnd}a
    storage_raw=/dev/r${storage_vnd}a
}

fstab_profile() {
    typeset mode
    [[ -f /etc/fstab && ! -L /etc/fstab ]] || return 1
    [[ $(stat -f '%u:%l' /etc/fstab) = 0:1 ]] || return 1
    root_parent /etc || return 1
    mode=$(stat -f '%Lp' /etc/fstab) || return 1
    [[ -n $mode && $mode != *[!0-7]* ]] || return 1
    (( (8#$mode & 022) == 0 )) || return 1
    bounded awk -v image="$storage_image" -v vnd="/dev/${storage_vnd}c" \
        -v device="$storage_device" -v point="$storage_mount" '
        $1==image || $2==vnd {if (NF!=6 || $1!=image || $2!=vnd || $3!="vnd" || $4!="rw,noauto" || $5!=0 || $6!=0) bad=1; a++}
        $1==device || $2==point {if (NF!=6 || $1!=device || $2!=point || $3!="ffs" || $4!="rw,nodev,nosuid,noexec,noauto" || $5!=0 || $6!=0) bad=1; b++}
        END {exit (bad || a!=1 || b!=1)}' /etc/fstab
}

associated() {
    typeset actual
    [[ -f $storage_image && ! -L $storage_image && $(stat -f '%i' "$storage_image") = "$storage_inode" ]] || return 1
    actual=$(bounded vnconfig -l "$storage_vnd") || return 1
    # Native producer spelling must be qualified on the target before delivery.
    case "$actual" in
    "$storage_vnd: covering $storage_image on "*", inode $storage_inode") return 0;;
    *) return 1;;
    esac
}

mounted() {
    typeset table
    table=$(bounded mount -t ffs) || return 1
    print -r -- "$table" | awk -v device="$storage_device" -v point="$1" \
        '$1==device && $2=="on" && $3==point && $4=="type" && $5=="ffs" {n++} END {exit(n!=1)}'
}

kernel_ready() {
    typeset answer
    associated && mounted "$storage_mount" || return 1
    [[ -f $storage_mount/quota.user && ! -L $storage_mount/quota.user ]] || return 1
    [[ $(stat -f '%u:%g:%Lp:%l' "$storage_mount/quota.user") = 0:0:600:1 ]] || return 1
    [[ $(stat -f '%u:%g:%Lp' "$storage_mount") = 0:0:755 ]] || return 1
    # Every interpolated path is fixed or admitted by profile's restricted charset.
    answer=$(bounded /usr/bin/su -m vmail -c "cd / && exec $daemon $storage_home $storage_uid $storage_limit $storage_mount $storage_index $storage_control") || return 1
    print -r -- "$answer" | grep -Eq '^\{"used_bytes":[0-9]+,"limit_bytes":209715200\}$'
}

block_access() {
    typeset point table count=0
    associated || return 1
    table=$(bounded mount -t ffs) || return 1
    for point in "$storage_mount" "$storage_guard/mount"; do
        if print -r -- "$table" | awk -v device="$storage_device" -v point="$point" \
            '$1==device && $3==point {n++} END {exit(n!=1)}'; then
            associated && bounded chown root:wheel "$point" || return 1
            associated && bounded chmod 700 "$point" || return 1
            [[ $(stat -f '%u:%g:%Lp' "$point") = 0:0:700 ]] || return 1
            count=$((count+1))
        fi
    done
    [[ $count -gt 0 || ( $(stat -f '%u:%g:%Lp' "$storage_mount") = 0:0:555 && ! -e $storage_home ) ]]
}

writers_stopped() {
    typeset role status
    for role in dovecot osmap_serve osmap_mailbox_helper; do
        status=0
        bounded rcctl check "$role" >/dev/null 2>&1 || status=$?
        [[ $status = 1 ]] || return 1
    done
}

on_disk_quota() {
    typeset values field index
    typeset fields
    [[ -f $1/quota.user && ! -L $1/quota.user ]] || return 1
    [[ $(stat -f '%u:%g:%Lp:%l' "$1/quota.user") = 0:0:600:1 ]] || return 1
    # Native dqblk is eight host-endian u32 fields. Read only UID2000's record.
    values=$(bounded dd if="$1/quota.user" bs=32 skip="$storage_uid" count=1 2>/dev/null |
        od -An -v -tu4) || return 1
    set -A fields -- $values
    [[ ${#fields[@]} = 8 ]] || return 1
    for index in 0 1 2 3 4 5 6 7; do
        field=${fields[$index]}
        [[ -n $field && ${#field} -le 10 && $field != *[!0-9]* ]] || return 1
        fields[$index]=$((10#$field))
    done
    [[ ${fields[0]} = 409600 && ( ${fields[1]} = 0 || ${fields[1]} = 409600 ) ]] || return 1
    print -r -- "ON_DISK_QUOTA=PASS UID=2000 HARD_BYTES=209715200 USED_BYTES=$((${fields[2]}*512))" >> "$storage_log"
}

guard_recount() {
    typeset source_sha raw_major raw_minor block_major block_minor value
    root_parent /root || return 1
    root_parent /sbin || return 1
    [[ ! -e $storage_guard && ! -L $storage_guard ]] || return 1
    [[ -c $storage_raw && -b $storage_device ]] || return 1
    raw_major=$(stat -f '%Hr' "$storage_raw") && raw_minor=$(stat -f '%Lr' "$storage_raw") || return 1
    block_major=$(stat -f '%Hr' "$storage_device") && block_minor=$(stat -f '%Lr' "$storage_device") || return 1
    for value in "$raw_major" "$raw_minor" "$block_major" "$block_minor"; do
        [[ -n $value && $value != *[!0-9]* ]] || return 1
    done
    [[ -f /sbin/quotacheck && ! -L /sbin/quotacheck && $(stat -f '%u:%l' /sbin/quotacheck) = 0:1 ]] || return 1
    case $(stat -f '%Lp' /sbin/quotacheck) in 555|755) ;; *) return 1;; esac
    source_sha=$(sha256 -q /sbin/quotacheck) || return 1
    bounded mkdir -m 700 "$storage_guard" || return 1
    bounded mkdir -m 700 "$storage_guard/mount" "$storage_guard/etc" "$storage_guard/dev" "$storage_guard/sbin" || return 1
    bounded cp /sbin/quotacheck "$storage_guard/sbin/quotacheck" || return 1
    bounded chmod 555 "$storage_guard/sbin/quotacheck" || return 1
    [[ $(sha256 -q "$storage_guard/sbin/quotacheck") = "$source_sha" ]] || return 1
    print -r -- "NATIVE_QUOTACHECK_SHA=$source_sha" >> "$storage_log" || return 1
    bounded mknod -m 600 "$storage_guard$storage_raw" c "$raw_major" "$raw_minor" || return 1
    bounded mknod -m 600 "$storage_guard$storage_device" b "$block_major" "$block_minor" || return 1
    print -r -- "$storage_device /mount ffs rw,userquota 0 2" > "$storage_guard/etc/fstab" || return 1
    bounded chmod 600 "$storage_guard/etc/fstab" || return 1
    associated && bounded mount -t ffs -o nodev,nosuid,noexec "$storage_device" "$storage_guard/mount" || return 1
    associated && mounted "$storage_guard/mount" && block_access || return 1
    on_disk_quota "$storage_guard/mount" || return 1
    # The installed native binary must be static; an unavailable loader fails closed.
    # Pass2/userquota exist only in this private chroot, never the host fstab.
    associated && bounded chroot "$storage_guard" /sbin/quotacheck -uv /mount > "$storage_guard/check.out" || return 1
    grep -Fx "*** Checking user quotas for $storage_raw (/mount), wait" "$storage_guard/check.out" >/dev/null || return 1
    on_disk_quota "$storage_guard/mount" || return 1
    associated && bounded umount "$storage_guard/mount" || return 1
    bounded rm "$storage_guard/check.out" "$storage_guard/etc/fstab" "$storage_guard/sbin/quotacheck" \
        "$storage_guard$storage_raw" "$storage_guard$storage_device" || return 1
    bounded rmdir "$storage_guard/mount" "$storage_guard/etc" "$storage_guard/sbin" "$storage_guard/dev" "$storage_guard" || return 1
}

rc_check() (
    storage_deadline=$(($(date +%s)+30))
    profile && fstab_profile && kernel_ready
)

rc_start() (
    set -eu
    set -o pipefail
    umask 077
    ulimit -c 0
    storage_recovery_deadline=$(($(date +%s)+180))
    storage_deadline=$((storage_recovery_deadline-20))
    storage_complete=no
    storage_profile_valid=no
    storage_log=$(mktemp /var/log/osmap-duncan-storage.XXXXXXXX) || exit 1
    trap 'status=$?; trap - EXIT HUP INT TERM; storage_deadline=$storage_recovery_deadline; if [[ $storage_complete != yes ]]; then access=UNCONFIRMED; if [[ $storage_profile_valid = yes ]] && block_access; then access=ROOT_ONLY_OR_ABSENT; fi; print -r -- "DUNCAN_STORAGE_START=REFUSED STATUS=$status ACCESS=$access" >> "$storage_log"; print -u2 "DUNCAN_STORAGE_START=REFUSED ACCESS=$access LOG=$storage_log"; fi; exit "$status"' EXIT
    trap 'exit 1' HUP INT TERM
    must profile
    must fstab_profile
    storage_profile_valid=yes
    if ! associated; then
        # Never evict an occupied slot. mount_vnd/vnconfig itself refuses busy.
        must bounded mount -t vnd "$storage_image" "/dev/${storage_vnd}c"
        must associated
    fi
    if mounted "$storage_mount"; then
        must block_access
        # Repair of an already-mounted unhealthy live store is not automatic.
        must writers_stopped
        bounded fstat -f "$storage_mount" | awk 'NR>1 {busy=1} END {exit busy}' || exit 1
        must associated
        must bounded umount "$storage_mount"
    fi
    [[ -d $storage_mount && ! -L $storage_mount && ! -e $storage_home ]] || exit 1
    [[ $(realpath "$storage_mount") = "$storage_mount" && $(stat -f '%u:%g:%Lp' "$storage_mount") = 0:0:555 ]] || exit 1
    must associated
    # There must be no mount from this device anywhere before offline fsck.
    table=$(bounded mount) || exit 1
    print -r -- "$table" | awk -v device="$storage_device" '$1==device {found=1} END {exit found}' || exit 1
    must bounded fsck -p "$storage_raw"
    must guard_recount
    must associated
    must bounded mount -t ffs -o nodev,nosuid,noexec "$storage_device" "$storage_mount"
    must associated
    must mounted "$storage_mount"
    [[ $(stat -f '%u:%g:%Lp' "$storage_mount") = 0:0:700 ]] || exit 1
    must on_disk_quota "$storage_mount"
    must associated
    must bounded quotaon -u "$storage_mount"
    # The kernel quota is active before exposing any account-owned child.
    must associated
    must mounted "$storage_mount"
    must bounded chmod 755 "$storage_mount"
    must kernel_ready
    storage_complete=yes
    print 'DUNCAN_STORAGE_START=PASS' >> "$storage_log"
    print 'DUNCAN_STORAGE_START=PASS UID=2000 HARD_BYTES=209715200'
)

rc_stop() (
    set -eu
    set -o pipefail
    umask 077
    storage_deadline=$(($(date +%s)+60))
    storage_log=$(mktemp /var/log/osmap-duncan-stop.XXXXXXXX) || exit 1
    trap 'status=$?; trap - EXIT HUP INT TERM; if [[ $status != 0 ]]; then print -r -- "DUNCAN_STORAGE_STOP=REFUSED STATUS=$status" >> "$storage_log"; print -u2 "DUNCAN_STORAGE_STOP=REFUSED LOG=$storage_log"; fi; exit "$status"' EXIT
    trap 'exit 1' HUP INT TERM
    must profile
    must fstab_profile
    writers_stopped || { print -u2 'DUNCAN_STORAGE_STOP=REFUSED WRITERS_RUNNING'; exit 1; }
    must associated
    must mounted "$storage_mount"
    bounded fstat -f "$storage_mount" | awk 'NR>1 {busy=1} END {exit busy}' || exit 1
    must block_access
    must associated
    must bounded quotaoff -u "$storage_mount"
    must associated
    must bounded umount "$storage_mount"
    [[ $(stat -f '%u:%g:%Lp' "$storage_mount") = 0:0:555 && ! -e $storage_home ]] || exit 1
    must associated
    must bounded vnconfig -u "$storage_vnd"
    print 'DUNCAN_STORAGE_STOP=PASS UNDERLYING_MOUNTPOINT=ROOT_READ_ONLY'
)

case "$1" in
stop)
    # rc.subr's daemon stop fallback waits/signals when readiness stays true.
    # A maintenance refusal must instead return immediately with its status.
    [[ $(id -u) = 0 ]] || exit 1
    rc_stop
    ;;
*) rc_cmd "$1";;
esac

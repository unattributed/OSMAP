# Local obsd1 development dataset; this is not the Toronto mail authority.
# Install only after confirming the local helper socket, grant and dataset.
# Production runtime safeguards also apply to this development installation.
# HTTPS terminates at the existing obsd1 edge; the application stays loopback.
# Account onboarding uses a fresh synthetic @osmap-password.invalid identity.
# Never copy Toronto password hashes or overwrite retained S04-02 account state.

OSMAP_RUN_MODE=serve
OSMAP_ENV=production
OSMAP_LISTEN_ADDR=127.0.0.1:8080
OSMAP_ALLOWED_HOSTS=obsd1.blackbagsecurity.com
OSMAP_OPENBSD_CONFINEMENT_MODE=enforce

# Both credential authentication and epoch checks use the fixed local Rust
# account service. Keep all three purpose keys distinct and permission protected.
# No rollout selector: every account in this isolated frontend uses local native
# authority. The helper's explicit account allowlists control enrollment.
OSMAP_ACCOUNT_ADMISSION_SOCKET=/var/run/osmap-account-admission/admission.sock
OSMAP_ACCOUNT_ADMISSION_KEY_FILE=/var/lib/osmap-s04-02/keys/admission.key
OSMAP_ACCOUNT_ADMISSION_HELPER_UID=0
OSMAP_ACCOUNT_MUTATION_SOCKET=/var/run/osmap-account-mutation/mutation.sock
OSMAP_ACCOUNT_MUTATION_KEY_FILE=/var/lib/osmap-s04-02/keys/mutation.key
OSMAP_ACCOUNT_MUTATION_SESSION_PROOF_KEY_FILE=/var/lib/osmap-s04-02/keys/session-proof.key
OSMAP_ACCOUNT_MUTATION_HELPER_UID=0

# Local Dovecot and mailbox helper only; never use /var/lib/osmap-bridge paths.
# The mailbox grant must match the existing local helper's private grant bytes.
OSMAP_DOVEADM_AUTH_SOCKET_PATH=/var/run/osmap-auth
OSMAP_MAILBOX_HELPER_SOCKET_PATH=/var/lib/osmap-helper/run/mailbox-helper.sock
OSMAP_MAILBOX_HELPER_PEER_UID=2000
OSMAP_MAILBOX_HELPER_GRANT_KEY_PATH=/var/lib/osmap-s04-02/keys/mailbox-helper-grant.key

# Reuse the qualified local state in place. Do not copy or reset sessions,
# factors, replay counters, password results, rate limits or contained markers.
OSMAP_STATE_DIR=/var/lib/osmap-s04-02/state
OSMAP_RUNTIME_DIR=/var/lib/osmap-s04-02/state/run
OSMAP_SESSION_DIR=/var/lib/osmap-s04-02/state/sessions
OSMAP_SETTINGS_DIR=/var/lib/osmap-s04-02/state/settings
OSMAP_DRAFT_DIR=/var/lib/osmap-s04-02/state/drafts
OSMAP_AUDIT_DIR=/var/lib/osmap-s04-02/state/audit
OSMAP_CACHE_DIR=/var/lib/osmap-s04-02/state/cache
OSMAP_TOTP_SECRET_DIR=/var/lib/osmap-s04-02/state/secrets/totp
OSMAP_LOG_DIR=/var/log/osmap-s04-02
OSMAP_STDERR_LOG_PATH=/var/log/osmap-s04-02/serve.log
OSMAP_LOG_LEVEL=info
OSMAP_LOG_FORMAT=text

OSMAP_HTTP_MAX_CONCURRENT_CONNECTIONS=16
OSMAP_MAILBOX_WORKER_BUDGET=8
OSMAP_SEARCH_WORKER_BUDGET=4
OSMAP_SEND_WORKER_BUDGET=2
OSMAP_AUTH_WORKER_BUDGET=4
OSMAP_EXPENSIVE_REQUEST_TIMEOUT_SECONDS=5
OSMAP_AUTH_BACKEND_TIMEOUT_SECONDS=20
OSMAP_SESSION_LIFETIME_SECS=43200
OSMAP_SESSION_IDLE_TIMEOUT_SECS=1800
OSMAP_TOTP_ALLOWED_SKEW_STEPS=1
OSMAP_LOGIN_THROTTLE_MAX_FAILURES=5
OSMAP_LOGIN_THROTTLE_REMOTE_MAX_FAILURES=12
OSMAP_LOGIN_THROTTLE_WINDOW_SECS=300
OSMAP_LOGIN_THROTTLE_LOCKOUT_SECS=900

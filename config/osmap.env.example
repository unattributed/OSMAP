# OSMAP example configuration for local and staging bootstrap work.
# Copy this into an operator-managed environment file or service definition
# rather than editing the committed example in place.

# Supported run modes:
# - bootstrap
# - serve
# - mailbox-helper
OSMAP_RUN_MODE=bootstrap
OSMAP_ENV=development
OSMAP_LISTEN_ADDR=127.0.0.1:8080
# Comma-separated Host header allow-list used for request routing and
# Origin/Referer validation. Production deployments should set the external
# browser hostname, for example `mail.example.test`.
OSMAP_ALLOWED_HOSTS=localhost
# Optional explicit Dovecot auth socket path for least-privilege deployments.
# Leave unset unless the host provides a dedicated socket that the OSMAP runtime
# user is allowed to reach.
# OSMAP_DOVEADM_AUTH_SOCKET_PATH=/var/run/osmap/dovecot-auth
# Optional explicit Dovecot userdb socket path for mailbox and message helper
# lookups in least-privilege deployments.
# Leave unset unless the host provides a dedicated socket that the OSMAP runtime
# user is allowed to reach.
# OSMAP_DOVEADM_USERDB_SOCKET_PATH=/var/run/osmap/dovecot-userdb
# Mailbox-helper Unix socket path.
# Production `OSMAP_RUN_MODE=serve` now requires this so the browser runtime
# does not silently fall back to direct mailbox backends.
# Set the same path for `OSMAP_RUN_MODE=mailbox-helper` when the helper should
# bind a specific socket path.
# Split OpenBSD service examples now live under `maint/openbsd/`.
# OSMAP_MAILBOX_HELPER_SOCKET_PATH=/var/lib/osmap/run/mailbox-helper.sock
# Permission-restricted shared HMAC key for helper request grants. Required
# whenever the mailbox helper socket is configured. Generate at least 32 random
# bytes and install it owner-readable only, for example mode 0600.
# OSMAP_MAILBOX_HELPER_GRANT_KEY_PATH=/var/lib/osmap/secrets/mailbox-helper-grant.key
OSMAP_STATE_DIR=/var/lib/osmap
OSMAP_RUNTIME_DIR=/var/lib/osmap/run
OSMAP_SESSION_DIR=/var/lib/osmap/sessions
OSMAP_SETTINGS_DIR=/var/lib/osmap/settings
OSMAP_DRAFT_DIR=/var/lib/osmap/drafts
OSMAP_AUDIT_DIR=/var/lib/osmap/audit
# OpenBSD service launchers route daemon stderr/stdout to /var/log/osmap.
# Keep application state/audit directories under /var/lib and operator-visible
# daemon logs under /var/log.
# OSMAP_LOG_DIR=/var/log/osmap
# OSMAP_STDERR_LOG_PATH=/var/log/osmap/serve.log
OSMAP_CACHE_DIR=/var/lib/osmap/cache
OSMAP_TOTP_SECRET_DIR=/var/lib/osmap/secrets/totp
OSMAP_LOG_LEVEL=info
OSMAP_LOG_FORMAT=text
OSMAP_HTTP_MAX_CONCURRENT_CONNECTIONS=16
# Route-class budgets for slow synchronous browser work. Keep each value at or
# below OSMAP_HTTP_MAX_CONCURRENT_CONNECTIONS.
OSMAP_MAILBOX_WORKER_BUDGET=8
OSMAP_SEARCH_WORKER_BUDGET=4
OSMAP_SEND_WORKER_BUDGET=2
OSMAP_AUTH_WORKER_BUDGET=4
OSMAP_EXPENSIVE_REQUEST_TIMEOUT_SECONDS=5
OSMAP_SESSION_LIFETIME_SECS=43200
OSMAP_SESSION_IDLE_TIMEOUT_SECS=1800
OSMAP_TOTP_ALLOWED_SKEW_STEPS=1
# Application-layer login throttling for the browser auth path.
OSMAP_LOGIN_THROTTLE_MAX_FAILURES=5
OSMAP_LOGIN_THROTTLE_REMOTE_MAX_FAILURES=12
OSMAP_LOGIN_THROTTLE_WINDOW_SECS=300
OSMAP_LOGIN_THROTTLE_LOCKOUT_SECS=900
# Application-layer submission throttling for the browser send path.
OSMAP_SUBMISSION_THROTTLE_MAX_SUBMISSIONS=10
OSMAP_SUBMISSION_THROTTLE_REMOTE_MAX_SUBMISSIONS=25
OSMAP_SUBMISSION_THROTTLE_WINDOW_SECS=300
OSMAP_SUBMISSION_THROTTLE_LOCKOUT_SECS=900
# Application-layer throttling for the browser message-move path.
OSMAP_MESSAGE_MOVE_THROTTLE_MAX_MOVES=20
OSMAP_MESSAGE_MOVE_THROTTLE_REMOTE_MAX_MOVES=60
OSMAP_MESSAGE_MOVE_THROTTLE_WINDOW_SECS=300
OSMAP_MESSAGE_MOVE_THROTTLE_LOCKOUT_SECS=900
OSMAP_OPENBSD_CONFINEMENT_MODE=disabled
